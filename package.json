{
  "name": "jevonian",
  "version": "0.7.2",
  "private": false,
  "description": "Local-first model router for coding agents: one endpoint, automatic model selection, cache-aware session stickiness.",
  "homepage": "https://github.com/xinyao27/jevonian#readme",
  "bugs": {
    "url": "https://github.com/xinyao27/jevonian/issues"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyao27/jevonian.git"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "bin": {
    "jevonian": "bin/jevonian.js"
  },
  "files": [
    "bin/jevonian.js",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run web:build && go build -o jevonian ./cmd/jevonian",
    "start": "./jevonian serve",
    "web:dev": "vp -C web dev",
    "web:build": "vp -C web build",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "test": "go test ./... && node --test test/*.test.js",
    "smoke": "bash scripts/smoke.sh",
    "check": "vp check --fix",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "up": "taze major -Ir",
    "prepare": "vp config"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "echarts": "^6.1.0",
    "motion": "^14.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@lobehub/icons": "^5.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "taze": "latest",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1"
}
